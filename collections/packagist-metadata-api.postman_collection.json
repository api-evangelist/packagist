              "id": "3dd47efc-fcca-40a1-bb7e-361a149189a9",
              "protocolProfileBehavior": {
                "disableBodyPruning": true
              },
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/metadata/changes.json?since=<long>",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "metadata",
                    "changes.json"
                  ],
                  "query": [
                    {
                      "description": "Unix timestamp (milliseconds) to fetch changes since.",
                      "key": "since",
                      "value": "<long>"
                    }
                  ]
                },
                "description": "Stream package metadata changes since a given timestamp. Retained for 24 hours only."
              },
