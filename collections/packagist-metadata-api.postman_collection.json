          "name": "Get Metadata Changes",
          "request": {
            "name": "Get Metadata Changes",
            "description": {
              "content": "Stream package metadata changes since a given timestamp. Retained for 24 hours only.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "metadata",
                "changes.json"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "since",
                  "value": "<long>",
                  "description": "Unix timestamp (milliseconds) to fetch changes since."
                }
              ],
              "variable": []
